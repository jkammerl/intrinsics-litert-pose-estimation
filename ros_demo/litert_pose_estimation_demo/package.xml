<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>litert_pose_estimation_demo</name>
  <version>0.1.0</version>
  <description>
    Demo for litert_pose_estimation: publishes a recorded RGB-D frame as a
    camera would and triggers the LiteRT pose estimation.
  </description>
  <maintainer email="julius@kammerl.de">Julius Kammerl</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>litert_pose_estimation</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
